# ============================================================================
# VARIABLES DE ENTORNO PARA VERCEL / SUPABASE
# ============================================================================

# 1. URL de conexión a Supabase PostgreSQL:
# Obtener en Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Ejemplo: postgresql://postgres.abcdefghijklm:[TU_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# 2. Clave secreta para sesiones en producción (generar una cadena aleatoria):
SECRET_KEY=clave-secreta-produccion-viaticos-unsl-2026
